# Business Configuration for Timesheet Tracker
# Copy this file to .env and update with your actual business information
# DO NOT commit the .env file to version control

# Your Company Info
REACT_APP_COMPANY_NAME=Your Company Name
REACT_APP_COMPANY_ADDRESS_LINE1=Your Address Line 1
REACT_APP_COMPANY_ADDRESS_LINE2=City, State ZIP
REACT_APP_COMPANY_PHONE=(555) 123-4567
REACT_APP_COMPANY_EMAIL=your.email@company.com

# Client Info (default client - can be overridden per invoice)
REACT_APP_CLIENT_NAME=Client Company Name
REACT_APP_CLIENT_ADDRESS_LINE1=Client Address Line 1
REACT_APP_CLIENT_ADDRESS_LINE2=Client City, State ZIP
REACT_APP_CLIENT_CONTACT=Client Contact Name

# Billing Info
REACT_APP_HOURLY_RATE=50
REACT_APP_JOB_TITLE=Software Engineering

# Invoice Settings
REACT_APP_INVOICE_PREFIX=INV
REACT_APP_PAYMENT_TERMS=Net 30
